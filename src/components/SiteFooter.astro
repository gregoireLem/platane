---
import Icon from './Icon.astro';
import { site } from '../data/site';
---

<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <img class="site-footer__logo" src="/brand/logo-vertical-light.jpg" alt="Au Platane" />
      <p class="site-footer__label">{site.label}</p>
      <ul class="site-footer__hours">
        {site.openingHours.map((item) => (
          <li>{item.day} — {item.hours}{'note' in item && <small class="hours-note">{item.note}</small>}</li>
        ))}
      </ul>
      <p class="site-footer__hours"><strong>Horaires de service</strong><br />{site.serviceHours}</p>
    </div>

    <div class="site-footer__links">
      <a href={`mailto:${site.email}`}>
        <Icon name="envelope" />
        {site.email}
      </a>
      <a class="site-footer__instagram" href={site.instagramUrl} target="_blank" rel="noreferrer">
        <Icon name="instagram" />
        Instagram
      </a>
      <a href={`tel:${site.phoneRaw}`}>
        <Icon name="phone" />
        {site.phoneDisplay}
      </a>
    </div>
  </div>
</footer>
